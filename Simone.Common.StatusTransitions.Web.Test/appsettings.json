{
  "ConnectionStrings": {
    "Database": "Data Source=localhost;Initial Catalog=StatusTransitions.Test;User ID=userID;Password=password;MultipleActiveResultSets=True;TrustServerCertificate=True",
    "Tickets": "Data Source=localhost;Initial Catalog=Simone.Tickets;User ID=userID;Password=password;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "IdentityOptions": {
    "ApplicationName": "Simon-e Tech Service",
    "AuthorityUrl": "https://my-simone.identity.server",
    "ApplicationUrl": "https://localhost:7148",
    "PostLogoutRedirectUrl": "https://localhost:7148/signin-oidc",
    "SecurityUrl": "https://my-simone.security.server",
    "ClientName": "ClientName",
    "ClientSecret": "ClientSecret",
    "CookieName": "SimoneDevelopment",
    "Username": "username",
    "Password": "password",
    "TicketConnectionStringName": "Tickets",
    "RequiredScopes": [
      "Simone"
    ]
  },
  "RabbitMQ": {
    "Host": "simone_rabbit_mq",
    "Username": "my-user-for-RabbitMQ",
    "Password": "my-Password-for-RabbitMQ",
    "Exchanges": [
      "Simone-Notifications"
    ],
    "Errors": {
      "Name": "Errors",
      "Exchange": "Simone-Errors"
    },
    "NotificationsExchange": "Simone-Notifications"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Http.ResponseCookies": "Warning",
        "Simone": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}